# Frontend environment configuration (EXAMPLE).
# Copy to `.env.local` and adjust. The real `.env.local` is gitignored.
# Only NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAX_RANGE_DAYS=92
NEXT_PUBLIC_JOB_POLL_INTERVAL_MS=3000
NEXT_PUBLIC_ENABLE_ASSISTANT=false
