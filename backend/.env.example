# ─────────────────────────────────────────────────────────────
# Backend environment configuration (EXAMPLE).
# Copy to `.env` and fill in real values.  The real `.env` is gitignored.
#
# IMPORTANT: do NOT put inline comments after a value on the same line.
# Some env parsers keep "# ..." as the value when the field is left blank.
# All explanatory comments below are on their own lines above each key.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=client-data-extraction
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ── Security / Auth ──────────────────────────────────────────
# REQUIRED — generate a long random string: openssl rand -hex 48
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# argon2 | bcrypt
PASSWORD_HASH_SCHEME=argon2
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Over plain HTTP (IP deploy) keep COOKIE_SECURE=false. Set true once TLS is in front.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Initial admin + demo data (used by `python -m app.scripts.seed`) ──
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
# true seeds demo shortcodes 8990, 1234
SEED_DEMO_DATA=false

# ── Database (metadata only — never client CSV data) ─────────
# REQUIRED. Examples:
#   postgresql+psycopg://user:pass@localhost:5432/extraction
#   sqlite:///./app.db   (local dev only)
# NOTE: URL-encode special chars in the password (e.g. '@' -> '%40').
DATABASE_URL=

# ── Redis / Celery ───────────────────────────────────────────
# REQUIRED
REDIS_URL=redis://localhost:6379/0
# Fall back to REDIS_URL if left empty
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=3000
CELERY_TASK_TIME_LIMIT=21600
CELERY_WORKER_CONCURRENCY=4
CELERY_MAX_RETRIES=3
# How often Celery beat runs the retention cleanup (seconds; default daily)
RETENTION_CLEANUP_INTERVAL_SECONDS=86400

# ── AWS / S3 (read-only source; Phase 3+) ────────────────────
# Region where the bucket lives, e.g. me-central-1
AWS_REGION=
# Leave blank to use an attached IAM role instead of static keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# e.g. bk-kannel
S3_BUCKET=
# Optional — only for S3-compatible stores; MUST be a full URL or left blank
S3_ENDPOINT_URL=
# Folder of daily files, e.g. daily-jasminfiles-fatib
S3_PREFIX=
S3_FILE_TEMPLATE=daily-data_{yyyy}-{mm}-{dd}.csv
# list | template
S3_DISCOVERY_MODE=list
S3_MAX_RETRIES=5

# ── CSV extraction (Phase 4) ─────────────────────────────────
# The shortcode is matched against THIS column (e.g. source_addr == 8990).
CSV_SHORTCODE_COLUMN=source_addr
# Optional additional filter column (e.g. destination_addr / MSISDN).
CSV_DESTINATION_COLUMN=destination_addr
CSV_DELIMITER=,
CSV_HAS_HEADER=true
# none | gzip
CSV_COMPRESSION=none
# Optional — set both to enable sub-day time filtering
CSV_TIMESTAMP_COLUMN=
CSV_TIMESTAMP_FORMAT=
EXTRACTION_PARALLEL_FILES=true

# ── Jobs / storage / retention (Phase 5-8) ───────────────────
# ulid | uuid4
JOB_ID_STRATEGY=ulid
MAX_RANGE_DAYS=92
REPORT_STORAGE_PATH=./storage
REPORT_RETENTION_DAYS=30
ZIP_COMPRESSION_LEVEL=6

# ── Email (Phase 8) ──────────────────────────────────────────
EMAIL_ENABLED=false
# gmail | smtp | ses
EMAIL_PROVIDER=gmail
EMAIL_MAX_ATTACHMENT_BYTES=10485760
DOWNLOAD_LINK_EXPIRE_MINUTES=60
# Public base URL of THIS API, used to build download links inside emails.
PUBLIC_API_BASE_URL=http://192.168.255.171/api/v1

# Gmail OAuth2 (EMAIL_PROVIDER=gmail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_SENDER=

# SMTP (EMAIL_PROVIDER=smtp) — used only for the smtp provider
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ── n8n integration (external — do NOT deploy n8n; Phase 10) ─
N8N_BASE_URL=
N8N_SERVICE_TOKEN=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
