# ─────────────────────────────────────────────────────────────
# Backend environment configuration (EXAMPLE).
# Copy to `.env` and fill in real values.  The real `.env` is gitignored.
# NOTHING is hardcoded in code — every value below is read from the environment.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
APP_NAME=client-data-extraction
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ── Security / Auth (Phase 2) ────────────────────────────────
JWT_SECRET=                         # REQUIRED — generate a long random string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=argon2         # argon2 | bcrypt
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Refresh-token cookie. Over plain HTTP (IP deploy) keep COOKIE_SECURE=false,
# else the browser will not send the cookie. Set true once TLS is in front.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Initial admin + demo data (used by `python -m app.scripts.seed`) ──
FIRST_ADMIN_EMAIL=                  # e.g. admin@yourcompany.com
FIRST_ADMIN_PASSWORD=               # set a strong password, then run the seed
SEED_DEMO_DATA=false                # true seeds demo shortcodes 8990, 1234

# ── Database (metadata only — never client CSV data) ─────────
# REQUIRED. Examples:
#   postgresql+psycopg://user:pass@localhost:5432/extraction
#   sqlite:///./app.db   (local dev only)
DATABASE_URL=

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0            # REQUIRED
CELERY_BROKER_URL=redis://localhost:6379/1    # falls back to REDIS_URL if empty
CELERY_RESULT_BACKEND=redis://localhost:6379/2 # falls back to REDIS_URL if empty
CELERY_TASK_SOFT_TIME_LIMIT=3000
CELERY_TASK_TIME_LIMIT=21600
CELERY_WORKER_CONCURRENCY=4
CELERY_MAX_RETRIES=3

# ── AWS / S3 (read-only source; Phase 4) ─────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=                  # omit if using an attached IAM role
AWS_SECRET_ACCESS_KEY=              # omit if using an attached IAM role
S3_BUCKET=                          # e.g. bk-kannel
S3_ENDPOINT_URL=                    # optional (S3-compatible stores / testing)
S3_PREFIX=                          # folder of daily files, e.g. daily-jasminfiles-fatib
S3_FILE_TEMPLATE=daily-data_{yyyy}-{mm}-{dd}.csv
S3_DISCOVERY_MODE=list              # list | template
S3_MAX_RETRIES=5

# ── CSV extraction (Phase 4) ─────────────────────────────────
# The shortcode is matched against THIS column (e.g. source_addr == 8990).
CSV_SHORTCODE_COLUMN=source_addr
CSV_DELIMITER=,
CSV_HAS_HEADER=true
CSV_COMPRESSION=none                # none | gzip
CSV_TIMESTAMP_COLUMN=               # optional — enables sub-day time filtering
CSV_TIMESTAMP_FORMAT=
EXTRACTION_PARALLEL_FILES=true

# ── Jobs / storage / retention (Phase 5-8) ───────────────────
JOB_ID_STRATEGY=ulid                # ulid | uuid4
MAX_RANGE_DAYS=92
REPORT_STORAGE_PATH=./storage
REPORT_RETENTION_DAYS=30
ZIP_COMPRESSION_LEVEL=6

# ── Email (Phase 7) ──────────────────────────────────────────
EMAIL_PROVIDER=ses                  # ses | smtp
EMAIL_FROM_ADDRESS=
EMAIL_MAX_ATTACHMENT_BYTES=10485760
DOWNLOAD_LINK_EXPIRE_MINUTES=60

# ── n8n integration (external — do NOT deploy n8n; Phase 10) ─
N8N_BASE_URL=
N8N_SERVICE_TOKEN=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
