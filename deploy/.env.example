# ─────────────────────────────────────────────────────────────
# COMPOSE-LEVEL configuration (deploy/.env).
# Used by docker-compose.prod.yml for infrastructure + frontend build args.
# Copy to `deploy/.env` and fill in.  This file is gitignored.
#
# The APPLICATION's own settings live in backend/.env (see backend/.env.example
# and deploy/ENV_REFERENCE.md). Keep the two consistent (esp. Postgres creds).
# ─────────────────────────────────────────────────────────────

# ── Postgres (the bundled db service) ───────────────────────
# These create the DB user/password/name inside the Postgres container.
# backend/.env DATABASE_URL MUST use these same values with host `db`, e.g.:
#   DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_STRONG@db:5432/extraction
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=extraction

# ── API runtime ─────────────────────────────────────────────
API_WORKERS=2
CELERY_WORKER_CONCURRENCY=4

# ── Frontend build args (compiled into the client bundle) ───
# No public domain → use the server's IP over HTTP (same host as nginx):
NEXT_PUBLIC_API_BASE_URL=http://SERVER_IP/api/v1
# (If you later add a domain + TLS, use: https://your-domain.com/api/v1)
NEXT_PUBLIC_MAX_RANGE_DAYS=92
NEXT_PUBLIC_JOB_POLL_INTERVAL_MS=3000
NEXT_PUBLIC_ENABLE_ASSISTANT=false
# Auto-logout after this many minutes of inactivity.
NEXT_PUBLIC_IDLE_TIMEOUT_MIN=15
